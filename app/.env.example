# Copiez ce fichier en ".env" et renseignez votre clé API Anthropic.
# Obtenir une clé : https://console.anthropic.com/  (section API Keys)

ANTHROPIC_API_KEY=sk-ant-VOTRE_CLE_ICI

# Modèle Claude utilisé pour l'analyse du CCTP (modifiable).
# Exemples : claude-sonnet-4-6 (recommandé), claude-opus-4-8, claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-6

# Moteur Mammouth.ai (OpenAI-compatible), moteur par défaut depuis la v2.3.
# Obtenir une clé (format sk-…) : https://mammouth.ai/app/account/settings/api
MAMMOUTH_API_KEY=
MAMMOUTH_BASE=https://api.mammouth.ai/v1

# Moteur Mistral AI direct (API officielle, distincte de Mammouth).
# Obtenir une clé : https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_BASE=https://api.mistral.ai/v1

# Moteur IA utilisé quand la requête n'en précise pas : "mammouth" (défaut), "claude" ou "mistral".
# Repassez à "claude" une fois le solde Anthropic rechargé.
DEFAULT_PROVIDER=mammouth
