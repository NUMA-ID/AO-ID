# Copiez ce fichier en ".env" et renseignez la clé du moteur GB10.
#
# Moteur IA unique : GB10 (serveur vLLM interne ONE ID, machine GB10/DGX Spark,
# géré par l'équipe infra). API OpenAI-compatible.
# Les moteurs Claude / Mammouth / Mistral ont été retirés le 2026-09-09.

GB10_API_KEY=sk-...
GB10_BASE=https://llm.one-id.fr/v1

# Modèle vLLM chargé sur le serveur GB10 (modifiable si un autre modèle est déployé).
GB10_MODEL=unsloth/Qwen3.8-Flash-Next-GGUF

# Moteur par défaut (un seul disponible).
DEFAULT_PROVIDER=gb10
