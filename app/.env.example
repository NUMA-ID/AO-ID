# Copiez ce fichier en ".env" et renseignez votre clé API Anthropic.
# Obtenir une clé : https://console.anthropic.com/  (section API Keys)

ANTHROPIC_API_KEY=sk-ant-VOTRE_CLE_ICI

# Modèle Claude utilisé pour l'analyse du CCTP (modifiable).
# Exemples : claude-sonnet-4-6 (recommandé), claude-opus-4-8, claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-6

# (Optionnel) Moteur alternatif Mammouth.ai (OpenAI-compatible) — pour le choix « Mammouth » dans l'interface.
# Obtenir une clé : https://mammouth.ai/app/account/settings/api
MAMMOUTH_API_KEY=
MAMMOUTH_BASE=https://api.mammouth.ai/v1
